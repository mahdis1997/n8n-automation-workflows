{
  "name": "Smart News Digest Bot (No Paid API)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 24, "triggerAtHour": 8 } ] }
      },
      "id": "trg1",
      "name": "Every Morning 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": { "url": "https://techcrunch.com/feed/" },
      "id": "rss1",
      "name": "RSS - TechCrunch",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [440, 140]
    },
    {
      "parameters": { "url": "https://hnrss.org/frontpage" },
      "id": "rss2",
      "name": "RSS - Hacker News",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": { "url": "https://www.wired.com/feed/rss" },
      "id": "rss3",
      "name": "RSS - Wired",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [440, 460]
    },
    {
      "parameters": { "mode": "combine", "combinationMode": "mergeByPosition" },
      "id": "merge1",
      "name": "Merge Feeds 1+2",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [660, 220]
    },
    {
      "parameters": { "mode": "combine", "combinationMode": "mergeByPosition" },
      "id": "merge2",
      "name": "Merge Feeds All",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "const keywords = ['ai','startup','launch','security','open source','model','chip','robot'];\nconst seen = new Set();\nconst scored = [];\nfor (const item of items) {\n  const j = item.json;\n  const title = (j.title || '').trim();\n  if (!title || seen.has(title.toLowerCase())) continue;\n  seen.add(title.toLowerCase());\n  const text = (title + ' ' + (j.contentSnippet || '')).toLowerCase();\n  let score = 0;\n  for (const k of keywords) if (text.includes(k)) score++;\n  scored.push({ title, link: j.link, score, pubDate: j.pubDate });\n}\nscored.sort((a,b) => b.score - a.score);\nconst top = scored.slice(0, 10);\nlet digest = '📰 خلاصه اخبار امروز\\n\\n';\ntop.forEach((n,i) => { digest += `${i+1}. ${n.title}\\n${n.link}\\n\\n`; });\nreturn [{ json: { digest, count: top.length } }];"
      },
      "id": "code1",
      "name": "Dedupe + Score + Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{$json.count}}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        }
      },
      "id": "if1",
      "name": "Has News?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.digest}}",
        "additionalFields": {}
      },
      "id": "tg1",
      "name": "Send Telegram Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": "Digest Log",
        "columns": { "value": { "Date": "={{$now.format('yyyy-MM-dd')}}", "Digest": "={{$json.digest}}" } }
      },
      "id": "sheet1",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1540, 340]
    },
    {
      "parameters": {},
      "id": "noop1",
      "name": "No News Today",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1540, 460]
    }
  ],
  "connections": {
    "Every Morning 8AM": { "main": [[ { "node": "RSS - TechCrunch", "type": "main", "index": 0 }, { "node": "RSS - Hacker News", "type": "main", "index": 0 }, { "node": "RSS - Wired", "type": "main", "index": 0 } ]] },
    "RSS - TechCrunch": { "main": [[ { "node": "Merge Feeds 1+2", "type": "main", "index": 0 } ]] },
    "RSS - Hacker News": { "main": [[ { "node": "Merge Feeds 1+2", "type": "main", "index": 1 } ]] },
    "Merge Feeds 1+2": { "main": [[ { "node": "Merge Feeds All", "type": "main", "index": 0 } ]] },
    "RSS - Wired": { "main": [[ { "node": "Merge Feeds All", "type": "main", "index": 1 } ]] },
    "Merge Feeds All": { "main": [[ { "node": "Dedupe + Score + Build Digest", "type": "main", "index": 0 } ]] },
    "Dedupe + Score + Build Digest": { "main": [[ { "node": "Has News?", "type": "main", "index": 0 } ]] },
    "Has News?": { "main": [ [ { "node": "Send Telegram Digest", "type": "main", "index": 0 }, { "node": "Log to Google Sheets", "type": "main", "index": 0 } ], [ { "node": "No News Today", "type": "main", "index": 0 } ] ] }
  }
}
