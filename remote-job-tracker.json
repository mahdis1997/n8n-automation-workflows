{
  "name": "Remote Job Tracker & Alert (Free RemoteOK API)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "hours", "hoursInterval": 6 } ] } },
      "id": "trg1",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://remoteok.com/api",
        "options": { "headers": { "User-Agent": "Mozilla/5.0 n8n-job-tracker" } }
      },
      "id": "http1",
      "name": "Fetch Remote Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const keywords = ['automation','n8n','backend','python','api','no-code'];\nconst jobs = items[0].json.filter(j => j.id);\nconst matched = jobs.filter(j => {\n  const text = ((j.position||'') + ' ' + (j.tags||[]).join(' ')).toLowerCase();\n  return keywords.some(k => text.includes(k));\n});\nreturn matched.map(j => ({ json: { id: String(j.id), position: j.position, company: j.company, url: j.url, tags: (j.tags||[]).join(', ') } }));"
      },
      "id": "code1",
      "name": "Filter by Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": { "operation": "read", "sheetName": "Seen Jobs", "range": "A:A" },
      "id": "sheet1",
      "name": "Read Already-Seen Job IDs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [640, 460]
    },
    {
      "parameters": {
        "jsCode": "const seenIds = new Set($('Read Already-Seen Job IDs').all().map(i => String(i.json.id)));\nconst newJobs = items.filter(i => !seenIds.has(i.json.id));\nreturn newJobs;"
      },
      "id": "code2",
      "name": "Remove Already-Seen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [ { "leftValue": "={{$json.id}}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } } ],
          "combinator": "and"
        }
      },
      "id": "if1",
      "name": "Is New Job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1080, 380]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=💼 فرصت شغلی جدید:\n{{$json.position}} @ {{$json.company}}\nتگ‌ها: {{$json.tags}}\n{{$json.url}}"
      },
      "id": "tg1",
      "name": "Notify New Job",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1300, 280]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": "Seen Jobs",
        "columns": { "mappingMode": "autoMapInputData" }
      },
      "id": "sheet2",
      "name": "Save Job ID as Seen",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1300, 480]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[ { "node": "Fetch Remote Jobs", "type": "main", "index": 0 }, { "node": "Read Already-Seen Job IDs", "type": "main", "index": 0 } ]] },
    "Fetch Remote Jobs": { "main": [[ { "node": "Filter by Keywords", "type": "main", "index": 0 } ]] },
    "Filter by Keywords": { "main": [[ { "node": "Remove Already-Seen", "type": "main", "index": 0 } ]] },
    "Remove Already-Seen": { "main": [[ { "node": "Is New Job?", "type": "main", "index": 0 } ]] },
    "Is New Job?": { "main": [ [ { "node": "Notify New Job", "type": "main", "index": 0 }, { "node": "Save Job ID as Seen", "type": "main", "index": 0 } ], [] ] }
  }
}
